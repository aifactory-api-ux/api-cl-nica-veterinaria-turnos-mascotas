# Plantilla de configuración de la API Clínica Veterinaria.
#
# Copia este archivo a `.env` en la raíz del repositorio y ajusta los valores.
# Los nombres de estas variables son los que lee `app/core/config.py`.

# Cadena de conexión a PostgreSQL. Este valor corresponde a un PostgreSQL
# local; dentro de `docker compose` la conexión la fija el propio servicio
# `api` apuntando al servicio `db`.
DATABASE_URL=postgresql+psycopg://clinica:clinica@localhost:5432/clinica

# Clave de firma de los tokens JWT. Sustituye este valor por uno propio antes
# de usar la clínica con datos reales.
JWT_SECRET=cambia-esta-clave-en-produccion

# Algoritmo de firma de los tokens de acceso.
JWT_ALGORITHM=HS256

# Vigencia del token de acceso, en minutos.
JWT_EXPIRE_MINUTES=480
